# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# MySQL 配置
MYSQL_PASSWORD=root
MYSQL_USER=qwen
MYSQL_USER_PASSWORD=qwen123

# Redis 配置
REDIS_PASSWORD=

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/qwen_chat

# Spring AI Alibaba Dashscope API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# JWT 密钥（建议使用更长的随机字符串）
JWT_SECRET=qwen-chat-secret-key-for-jwt-token-generation-very-long-string

# 模型配置
AI_DASHSCOPE_MODEL=qwen-plus
