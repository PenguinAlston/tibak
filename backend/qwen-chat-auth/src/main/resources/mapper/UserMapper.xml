<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qwen.chat.auth.repository.UserMapper">

    <resultMap id="UserResult" type="com.qwen.chat.auth.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="avatar" column="avatar"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <select id="selectByUsername" resultMap="UserResult">
        SELECT * FROM users WHERE username = #{username} AND deleted = 0
    </select>

    <select id="selectByEmail" resultMap="UserResult">
        SELECT * FROM users WHERE email = #{email} AND deleted = 0
    </select>
</mapper>
